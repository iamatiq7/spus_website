# Copy this file to server/.env and fill in real values.
# NEVER commit the real .env file.

# Port for the Node server
PORT=3000

# Admin credentials for the submissions API (Basic auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Where db.json is stored (defaults to server/data)
# DATA_DIR=C:\path\to\safe\folder
